{
  "name": "mutable-realms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "uv run pytest",
    "lint": "uv run ruff check backend tests && npm run frontend-check",
    "migrate": "uv run python -m backend.cli migrate",
    "seed": "uv run python -m backend.cli seed",
    "validate": "uv run python -m backend.cli validate",
    "move-entity": "uv run python -m backend.cli move-entity",
    "serve": "uv run uvicorn backend.app.main:app --host 0.0.0.0 --port ${MUTABLE_REALMS_PORT:-8790} --workers 1",
    "frontend-check": "tsc --noEmit",
    "frontend-build": "vite build frontend"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
